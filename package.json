{
  "name": "git-fit-import",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action for importing data into git-fit (apple_health | 2bulu)",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js && esbuild src/shared.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/shared.cjs",
    "build:check": "npm run build && git diff --exit-code -- .github/git-fit-actions/import/dist/index.js .github/git-fit-actions/import/dist/shared.cjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@actions/cache": "6.2.0",
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
